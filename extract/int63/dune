(rocq.extraction
 (prelude ExtractInt63)
 (extracted_modules EliasFanoInt63Ocaml)
 (theories EliasFano Stdlib coqutil))

; Rocq extraction generates "'a Parray.t" with a spurious type variable.
; These rules sed-fix the generated files before compilation.
(rule
 (targets EliasFanoInt63.ml)
 (deps EliasFanoInt63Ocaml.ml)
 (action (with-stdout-to %{targets}
  (bash "sed \"s/ 'a Parray\\.t/ Parray.t/g\" %{deps}"))))

(rule
 (targets EliasFanoInt63.mli)
 (deps EliasFanoInt63Ocaml.mli)
 (action (with-stdout-to %{targets}
  (bash "sed \"s/ 'a Parray\\.t/ Parray.t/g\" %{deps}"))))

(library
 (name elias_fano_int63)
 (wrapped false)
 (modules EliasFanoInt63 ef_popcount)
 (libraries elias_fano rocq-runtime.kernel))
